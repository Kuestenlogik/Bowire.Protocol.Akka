<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Bowire contract package — IBowireProtocol + the model
         types used by DiscoverAsync / InvokeAsync return values. -->
    <PackageVersion Include="Kuestenlogik.Bowire" Version="1.6.1" />

    <!-- Akka.NET core — IActorRef / Mailbox / Extension contracts.
         Cluster + ClusterClient land here in 0.2.0 when the external-
         transport path ships. -->
    <PackageVersion Include="Akka" Version="1.5.68" />

    <!-- Test-only -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Akka.TestKit gives us TestProbe + ExpectMsg without needing
         the xunit-specific TestKit base class (Akka.TestKit.Xunit3
         doesn't exist; xunit2 base would conflict with xunit.v3). -->
    <PackageVersion Include="Akka.TestKit" Version="1.5.68" />
    <!-- XPlat coverage collector — drives the dotnet test coverage
         collection flag and drops one cobertura.xml per test project
         for CI / Codecov upload. -->
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.300" />
  </ItemGroup>
</Project>
